# Windows (Rtools). Vendored raylib 5.5, GLFW Win32 backend, no audio.
# Follows raylib's own MinGW build flags; not exercised in CI -- PRs welcome.

RAYLIB   = raylib
GLFW_INC = $(RAYLIB)/external/glfw/include

PKG_CPPFLAGS = -I. -I2D -I3D -I$(RAYLIB) -I$(GLFW_INC) \
               -I$(RAYLIB)/external/glfw/deps/mingw \
               -DPLATFORM_DESKTOP -DGRAPHICS_API_OPENGL_33 -D_GLFW_WIN32

RAYLIB_OBJECTS = \
  $(RAYLIB)/rcore.o \
  $(RAYLIB)/rshapes.o \
  $(RAYLIB)/rtextures.o \
  $(RAYLIB)/rtext.o \
  $(RAYLIB)/rmodels.o \
  $(RAYLIB)/utils.o \
  $(RAYLIB)/rglfw.o

OBJECTS = init.o \
  2D/rayplot_2D.o 2D/helper_2D.o 2D/layers_2D.o \
  2D/lifecycle_2D.o 2D/view_2D.o 2D/text_2D.o \
  3D/rayplot_3D.o \
  $(RAYLIB_OBJECTS)

PKG_LIBS = -lopengl32 -lgdi32 -lwinmm
